# Auto-detect text files and normalize line endings
* text=auto

# Enforce LF for markdown and configuration files
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.txt text eol=lf

# Binary assets
assets/** binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.webp binary
